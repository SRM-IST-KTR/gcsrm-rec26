# Backend URL for email + OTP + recruitment endpoints. Empty in dev -> Next.js
# rewrites proxy /api/otp/*, /api/email/* and /api/recruitment/* to
# http://localhost:3000 (see next.config.ts). Set to your deployed backend URL
# in production.
NEXT_PUBLIC_API_URL=

# API Key for direct / admin email dispatch endpoints (/api/email/send, /api/email/batch)
NEXT_PUBLIC_EMAIL_API_KEY=