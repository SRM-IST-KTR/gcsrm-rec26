# Backend URL for OTP + recruitment endpoints. Empty in dev -> the Next.js
# rewrites forward /api/otp/* and /api/recruitment/apply|submit to
# http://localhost:8000 (see next.config.ts). Set to your deployed backend URL
# in production. The key-guarded reads are served by the same-origin proxy
# routes under src/app/api/recruitment.
NEXT_PUBLIC_API_URL=

# Admin key for the backend's guarded recruitment reads (participant lookup +
# tasks). Used only by the server-side proxy routes under src/app/api/recruitment.
# Server-only — never prefix with NEXT_PUBLIC_.
SERVICE_API_KEY=

# Optional backend origin override for the server-side proxy routes.
# Falls back to NEXT_PUBLIC_API_URL, then http://localhost:8000.
# BACKEND_URL=